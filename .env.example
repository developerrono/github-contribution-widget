# Copy this file to server/.env and fill in your own values.
# Never commit the real .env file.

# A GitHub personal access token (classic or fine-grained) with
# read-only access to your contribution/profile data.
# Classic token: no special scopes are required to read public
# contribution data for your own account — "read:user" is sufficient.
GITHUB_TOKEN=your_github_token

# The GitHub username whose contributions this widget displays.
GITHUB_USERNAME=your_github_username

# Port the backend API listens on.
PORT=5000

# Comma-free, single origin the API should accept requests from in
# production (your deployed frontend URL). Leave unset for local
# development, where all origins are allowed.
# CORS_ORIGIN=https://your-widget.vercel.app
